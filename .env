# ---- Required: the three Azure OpenAI credentials ----
# Paste the endpoint exactly as Azure shows it, e.g. https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# (host-only like https://YOUR-RESOURCE.openai.azure.com/ also works; /openai/v1 is added for you)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=


# ---- Optional ----
# Embedding deployment (e.g. text-embedding-3-small). Chat models cannot create embeddings.
# If left empty, the app clusters with local TF-IDF instead (no extra API calls, less semantic).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# ---- Safety limits (protect your credit from accidental loops/errors) ----
MAX_CALLS_PER_RUN=60          # hard cap on API calls in one "Run analysis" click
MAX_CALLS_PER_DAY=300         # hard cap per calendar day (stored in voc.db, survives restarts/resets)
MAX_ITEMS_PER_RUN=30          # feedback items processed per click (rest stay pending)
MAX_ATTEMPTS=3                # an item that fails this many times is parked until you click "Retry failed"
MAX_CONSECUTIVE_FAILURES=3    # stop the run after this many failures in a row
MAX_THEME_CALLS=15            # max theme-naming calls per run
MAX_INPUT_CHARS=2000          # feedback text is truncated to this length before sending
MAX_OUTPUT_TOKENS=4000        # output cap per call (reasoning models also spend it on thinking)
# AZURE_REASONING_EFFORT=low  # optional, GPT-5 family: faster/cheaper (allowed values depend on model)
# AZURE_OMIT_TEMPERATURE=1    # force-omit temperature if your deployment name hides a GPT-5/o-series model

# ---- Who raised it: priority weights by role (higher = counts more in theme priority) ----
ROLE_WEIGHTS=client=1.5,user=1.0,tester=0.8,developer=0.7

# ---- Urgency boosts (all in percent; urgency never exceeds 100%) ----
AGE_STEP_DAYS=10              # every this many days since the entry's date...
AGE_BOOST_PCT_PER_STEP=5      # ...urgency goes up by this much
AGE_BOOST_MAX_PCT=30          # max total increase from age
REPEAT_BOOST_PCT_EACH=5       # each extra request on the same theme (from anyone) adds this
REPEAT_BOOST_MAX_PCT=20       # max total increase from repeats
# DATE_DAYFIRST=1             # set to 1 if CSV dates look like 31/12/2026 (day first)

# ---- Other ----
# SSL_CERT_FILE=C:\path\to\company-root-ca.pem   # corporate proxy root certificate
# SSL_USE_SYSTEM_CERTS=0                          # disable OS certificate store usage
# LLM_DEBUG=1                                     # print raw prompts/responses in the terminal

# ---- Aira chat assistant (all optional) ----
# AIRA_MAX_OUTPUT_TOKENS=1500        # output cap per Aira answer
# AIRA_REASONING_EFFORT=low          # GPT-5 family: low = faster/cheaper answers (default low)
# AIRA_MAX_QUESTIONS_PER_SESSION=40  # questions allowed per browser session
# AIRA_HISTORY_TURNS=6               # earlier messages sent along for follow-up questions

# ---- Admin Access (optional) ----
# ADMIN_PASSWORD=choose-a-password   # if set, Admin Access asks for it; leave unset for open access (as before)
